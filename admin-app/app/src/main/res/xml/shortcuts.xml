<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. اختصار الزر العائم الشامل (إضافة طلب والذكاء الاصطناعي) -->
    <shortcut
        android:shortcutId="floating_widget_shortcut"
        android:enabled="true"
        android:icon="@drawable/ic_floating_widget"
        android:shortcutShortLabel="@string/shortcut_floating_widget"
        android:shortcutLongLabel="@string/shortcut_floating_widget_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aboakbar.admin"
            android:targetClass="com.aboakbar.admin.FloatingAdminActivity" />
    </shortcut>

    <!-- 2. اختصار إضافة طلب جديد مباشر من الزر العائم -->
    <shortcut
        android:shortcutId="add_order_shortcut"
        android:enabled="true"
        android:icon="@drawable/ic_add_order_shortcut"
        android:shortcutShortLabel="@string/shortcut_add_order"
        android:shortcutLongLabel="@string/shortcut_add_order_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aboakbar.admin"
            android:targetClass="com.aboakbar.admin.FloatingAdminActivity">
            <extra
                android:name="extra_tab"
                android:value="tab_add_order" />
        </intent>
    </shortcut>

    <!-- 3. اختصار المساعد الذكي AI من الزر العائم -->
    <shortcut
        android:shortcutId="ai_assistant_shortcut"
        android:enabled="true"
        android:icon="@drawable/ic_ai_shortcut"
        android:shortcutShortLabel="@string/shortcut_ai_short"
        android:shortcutLongLabel="@string/shortcut_ai_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aboakbar.admin"
            android:targetClass="com.aboakbar.admin.FloatingAdminActivity">
            <extra
                android:name="extra_tab"
                android:value="tab_ai" />
        </intent>
    </shortcut>

    <!-- 4. اختصار إدارة الطلبات -->
    <shortcut
        android:shortcutId="orders_shortcut"
        android:enabled="true"
        android:icon="@drawable/ic_orders_shortcut"
        android:shortcutShortLabel="@string/shortcut_orders"
        android:shortcutLongLabel="@string/shortcut_orders_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aboakbar.admin"
            android:targetClass="com.aboakbar.admin.MainActivity">
            <extra
                android:name="OPEN_URL"
                android:value="https://aboakbr.com/abo1stor3hlaa2kbr8-47/orders/pending" />
        </intent>
    </shortcut>

</shortcuts>
