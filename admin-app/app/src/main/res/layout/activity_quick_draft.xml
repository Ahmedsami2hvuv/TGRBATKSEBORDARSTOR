<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/transparent"
    android:layout_gravity="center"
    android:gravity="center">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_alert"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvMainTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 إضافة طلب سريع"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#0288D1"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- النص المحدد -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="#E1F5FE"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvSelectedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#004D40"
                    android:textSize="14sp"
                    android:text="جاري تحميل النص..." />
            </ScrollView>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <!-- الخطوة الأولى: المجهزين -->
            <LinearLayout
                android:id="@+id/layoutStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="إسناد الطلب إلى المجهزين (يمكن اختيار أكثر من مجهز):"
                    android:textSize="16sp"
                    android:textColor="#546E7A"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPreparers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:layoutDirection="rtl"
                    app:singleSelection="false"
                    app:singleLine="false"
                    app:chipSpacingHorizontal="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCancel1"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="إلغاء"
                        android:backgroundTint="#90A4AE"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnNext"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="التالي"
                        android:backgroundTint="#03A9F4"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- الخطوة الثانية: المناطق -->
            <LinearLayout
                android:id="@+id/layoutStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="المنطقة مبهمة، يرجى اختيار المنطقة الدقيقة:"
                    android:textSize="16sp"
                    android:textColor="#E53935"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ابحث عن منطقة (أو اختر من الأسفل):"
                    android:textSize="14sp"
                    android:textColor="#546E7A"
                    android:layout_marginBottom="8dp" />

                <AutoCompleteTextView
                    android:id="@+id/autoCompleteRegions"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#ECEFF1"
                    android:padding="12dp"
                    android:hint="اكتب اسم المنطقة هنا..."
                    android:textColor="#263238"
                    android:layout_marginBottom="16dp"
                    android:completionThreshold="1" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupRegions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:layoutDirection="rtl"
                    app:singleSelection="true"
                    app:singleLine="false"
                    app:selectionRequired="false"
                    app:chipSpacingHorizontal="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBack"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="رجوع"
                        android:backgroundTint="#90A4AE"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnSubmitFinal"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="تأكيد وإرسال"
                        android:backgroundTint="#4CAF50"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
