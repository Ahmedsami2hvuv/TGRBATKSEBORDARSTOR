<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFloatingWindow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/bg_floating_window"
    android:elevation="24dp"
    android:padding="12dp">

    <!-- Header & Drag Handle Bar -->
    <RelativeLayout
        android:id="@+id/headerDragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:background="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="المساعد العائم (اسحب للتحريك)"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Voice TTS Mute/Unmute -->
            <ImageButton
                android:id="@+id/btnFloatingVoiceToggle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:tint="#38BDF8"
                android:contentDescription="صوت المساعد" />

            <!-- Clear Chat Trash -->
            <ImageButton
                android:id="@+id/btnFloatingTrashClear"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="#F87171"
                android:contentDescription="مسح الدردشة" />

            <!-- Close Window Button -->
            <ImageButton
                android:id="@+id/btnFloatingClose"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#94A3B8"
                android:contentDescription="إغلاق النافذة" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2564748B" />

    <!-- Chat Messages Scroll View -->
    <ScrollView
        android:id="@+id/floatingChatScrollView"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/floatingChatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </ScrollView>

    <!-- Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <ProgressBar
            android:id="@+id/floatingProgressBar"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:indeterminateTint="#38BDF8"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvFloatingStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎙️ تفضل بالتحدث..."
            android:textColor="#94A3B8"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Bottom Input and Mic Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Mic Button -->
        <ImageButton
            android:id="@+id/btnFloatingMic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_gradient"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#FFFFFF"
            android:contentDescription="الميكروفون" />

        <!-- Input Field -->
        <EditText
            android:id="@+id/etFloatingInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_floating_input"
            android:hint="اكتب أمرك أو الصق الرقم هنا..."
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="text"
            android:imeOptions="actionSend" />

        <!-- Send Button -->
        <Button
            android:id="@+id/btnFloatingSend"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_gradient"
            android:text="إرسال"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:minWidth="56dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>
</LinearLayout>
