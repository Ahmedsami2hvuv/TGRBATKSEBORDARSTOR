<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@android:color/transparent"
    android:gravity="center">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_alert"
            android:elevation="12dp">

            <!-- الأيقونة والعنوان الرئيسي -->
            <TextView
                android:id="@+id/tvAlertHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚨 طلب جديد وارد للنظام"
                android:textColor="#0288D1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- اسم المحل واسم المنطقة -->
            <TextView
                android:id="@+id/tvAlertTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اسم المحل — اسم المنطقة"
                android:textColor="#004D40"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <!-- رقم الطلب -->
            <TextView
                android:id="@+id/tvOrderNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="طلب رقم: #0"
                android:textColor="#546E7A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- تفاصيل الطلب كاملة -->
            <TextView
                android:id="@+id/tvOrderDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="التفاصيل..."
                android:textColor="#263238"
                android:textSize="16sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                android:gravity="right"
                android:layout_marginBottom="12dp" />

            <!-- حاوية الأزرار الرئيسية -->
            <LinearLayout
                android:id="@+id/layoutMainButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="4dp">

                    <!-- زر الإغلاق -->
                    <Button
                        android:id="@+id/btnCloseAlert"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:text="إغلاق التنبيه"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:backgroundTint="#90A4AE"
                        android:layout_marginEnd="4dp" />

                    <!-- زر فتح التطبيق -->
                    <Button
                        android:id="@+id/btnOpenApp"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:text="فتح الطلب"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:backgroundTint="#03A9F4"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- زر الرفض -->
                    <Button
                        android:id="@+id/btnRejectOrder"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:text="رفض الطلب"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:backgroundTint="#E53935"
                        android:layout_marginEnd="4dp" />

                    <!-- زر الإسناد -->
                    <Button
                        android:id="@+id/btnAssignOrder"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:text="إسناد الطلب"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:backgroundTint="#4CAF50"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- حاوية الإسناد (مخفية افتراضياً) -->
            <LinearLayout
                android:id="@+id/layoutAssign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="اختر المندوب لإسناد الطلب:"
                    android:textColor="#004D40"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:gravity="right" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgCouriers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layoutDirection="rtl" />

                </ScrollView>

                <!-- زر التأكيد -->
                <Button
                    android:id="@+id/btnConfirmAssign"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:text="تأكيد الإسناد"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#2E7D32" />
                
                <Button
                    android:id="@+id/btnCancelAssign"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="إلغاء"
                    android:textColor="#546E7A"
                    android:textSize="14sp"
                    android:backgroundTint="@android:color/transparent"
                    android:elevation="0dp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
