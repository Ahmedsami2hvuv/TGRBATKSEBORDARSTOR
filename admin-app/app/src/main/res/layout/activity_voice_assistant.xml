<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl">

    <!-- Header Section -->
    <RelativeLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#0F172A">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="✨ Gemini Live - مساعد أبو الأكبر"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC" />

        <Button
            android:id="@+id/btnToggleTts"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="🔊 الصوت"
            android:textSize="11sp"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />
    </RelativeLayout>

    <!-- Gemini Glowing Visualizer Center Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@id/headerContainer"
        android:layout_above="@id/bottomGeminiBar"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Status Indicator -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎙️ الميكروفون شغال... تحدث بحرية"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#38BDF8"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Gemini Glowing Center Orb Visualizer -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_margin="16dp">

            <ImageView
                android:id="@+id/ivGlowingOrb"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/bg_dialog_rounded"
                android:background="@drawable/btn_gradient"
                android:contentDescription="Gemini Glowing Orb" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✨ Live"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Transcript Speech Result -->
        <TextView
            android:id="@+id/tvTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#E2E8F0"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Response Area & Buttons ScrollView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#F1F5F9"
                    android:lineSpacingExtra="4dp" />

                <!-- حاوية الأزرار التفاعلية بالنقر المباشر -->
                <LinearLayout
                    android:id="@+id/buttonsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Bottom Controls & Gemini Floating Bar (مطابق للصور بالضبط) -->
    <LinearLayout
        android:id="@+id/bottomGeminiBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#0F172A"
        android:padding="12dp"
        android:elevation="12dp">

        <!-- Text Keyboard Input Area (عند فتح مفتاح الكتابة) -->
        <LinearLayout
            android:id="@+id/textInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/etCommandInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="اكتب أمرك الإداري النصي..."
                android:textSize="14sp"
                android:padding="12dp"
                android:background="#1E293B"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:layout_marginEnd="8dp"
                android:maxLines="2" />

            <Button
                android:id="@+id/btnSendText"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="إرسال"
                android:backgroundTint="#0284C7"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Gemini Live White Floating Action Buttons Bar (مطابق للصور 100%) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <!-- 1. زر إغلاق X عائم أبيض -->
            <Button
                android:id="@+id/btnClose"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="✕"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:backgroundTint="#FFFFFF"
                android:padding="0dp"
                android:layout_marginEnd="8dp" />

            <!-- 2. زر إيقاف/تفعيل الميكروفون عائم أبيض -->
            <Button
                android:id="@+id/btnMicToggle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="🎙️"
                android:textSize="18sp"
                android:textColor="#0F172A"
                android:backgroundTint="#FFFFFF"
                android:padding="0dp"
                android:layout_marginEnd="8dp" />

            <!-- 3. الشريط البيضاوي المتوهج المضيء لـ Gemini Live في المنتصف -->
            <Button
                android:id="@+id/btnGeminiPill"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="✨ Gemini Live"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0284C7"
                android:layout_marginEnd="8dp" />

            <!-- 4. زر فتح الكتابة النصية والمكالمات عائم أبيض -->
            <Button
                android:id="@+id/btnKeyboardToggle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="⌨️"
                android:textSize="18sp"
                android:textColor="#0F172A"
                android:backgroundTint="#FFFFFF"
                android:padding="0dp" />

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
