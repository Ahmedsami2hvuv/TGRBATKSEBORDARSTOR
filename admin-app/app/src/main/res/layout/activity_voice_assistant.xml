<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true">

    <!-- مساحة شفافة فارغة من الأعلى تمكن المدير من رؤية التطبيق والشاشة كلياً -->
    <View
        android:id="@+id/transparentClickDismiss"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomGeminiContainer"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Container المساعد الصوتي الشفاف والمنسق بدون خلفية سوداء معتمة -->
    <LinearLayout
        android:id="@+id/bottomGeminiContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <!-- حالة الاستماع والمؤشر الصغير الشفاف -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="4dp">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateTint="#38BDF8"
                android:visibility="gone"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ أستمع لك... تفضل بالتحدث يا أبو الأكبر"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0284C7"
                android:shadowColor="#FFFFFF"
                android:shadowRadius="4" />

            <Button
                android:id="@+id/btnToggleTts"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="12dp"
                android:text="🔊 الصوت"
                android:textSize="10sp"
                android:backgroundTint="#0284C7"
                android:textColor="#FFFFFF"
                android:paddingLeft="6dp"
                android:paddingRight="6dp" />
        </LinearLayout>

        <!-- نص الأمر المنطوق صوتاً -->
        <TextView
            android:id="@+id/tvTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp" />

        <!-- بلوك شفاف لعرض رد المساعد وتجربة الاستجابة -->
        <ScrollView
            android:id="@+id/responseScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="160dp"
            android:background="#F0F8FAFC"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:lineSpacingExtra="3dp" />

                <!-- حاوية الأزرار التفاعلية بالنقر المباشر -->
                <LinearLayout
                    android:id="@+id/buttonsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Text Keyboard Input Area -->
        <LinearLayout
            android:id="@+id/textInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etCommandInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="اكتب أمرك النصي هنا..."
                android:textSize="13sp"
                android:padding="10dp"
                android:background="#F1F5F9"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:layout_marginEnd="6dp"
                android:maxLines="2" />

            <Button
                android:id="@+id/btnSendText"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="إرسال"
                android:backgroundTint="#0284C7"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Gemini Live Floating Bar (الترتيب الدقيق من اليسار لليمين مطابق 100% للصورة) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layoutDirection="ltr">

            <!-- 1. زر إغلاق X على اليسار (أول زر من اليسار) -->
            <Button
                android:id="@+id/btnClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="✕"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:background="@drawable/white_circle_btn"
                android:backgroundTint="@null"
                android:padding="0dp"
                android:layout_marginEnd="8dp" />

            <!-- 2. زر الميكروفون المباشر -->
            <Button
                android:id="@+id/btnMicToggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="🎙️"
                android:textSize="16sp"
                android:textColor="#0F172A"
                android:background="@drawable/white_circle_btn"
                android:backgroundTint="@null"
                android:padding="0dp"
                android:layout_marginEnd="8dp" />

            <!-- 3. الكبسولة البيضاوية المتوهجة الملونة بالمنتصف المتفاعلة مع الصوت دمج الألوان -->
            <Button
                android:id="@+id/btnGeminiPill"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="✨"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/gemini_gradient_pill"
                android:backgroundTint="@null"
                android:layout_marginEnd="8dp" />

            <!-- 4. زر السهم المباشر (إرسال النص) -->
            <Button
                android:id="@+id/btnSendTextAction"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="⬆️"
                android:textSize="16sp"
                android:textColor="#0F172A"
                android:background="@drawable/white_circle_btn"
                android:backgroundTint="@null"
                android:padding="0dp"
                android:layout_marginEnd="8dp" />

            <!-- 5. زر الكيبورد على اليمين (أخر زر من اليمين) -->
            <Button
                android:id="@+id/btnKeyboardToggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="⌨️"
                android:textSize="16sp"
                android:textColor="#0F172A"
                android:background="@drawable/white_circle_btn"
                android:backgroundTint="@null"
                android:padding="0dp" />

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
