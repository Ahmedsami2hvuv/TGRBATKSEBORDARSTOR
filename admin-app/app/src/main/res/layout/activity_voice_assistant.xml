<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true">

    <!-- مساحة شفافة فارغة تمكن من مشاهدة الشاشة والتطبيق خلف المساعد -->
    <View
        android:id="@+id/transparentClickDismiss"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomGeminiBarLayout"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Container رد واستجابة المساعد الشفاف التلقائي عند التحدث -->
    <LinearLayout
        android:id="@+id/responseContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomGeminiBarLayout"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/responseScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="180dp"
            android:background="#F8FAFC"
            android:padding="12dp"
            android:elevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎙️ المساعد الاستجابة"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0284C7"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvTranscript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:lineSpacingExtra="3dp" />

                <LinearLayout
                    android:id="@+id/buttonsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:visibility="gone"
        android:layout_above="@id/bottomGeminiBarLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnToggleTts"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:visibility="gone"
        android:text="🔊" />

    <!-- Text Keyboard Input Area (عند اختيار الكتابة بالنص) -->
    <LinearLayout
        android:id="@+id/textInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomGeminiBarLayout"
        android:orientation="horizontal"
        android:visibility="gone"
        android:padding="8dp"
        android:background="#FFFFFF">

        <EditText
            android:id="@+id/etCommandInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="اكتب أمرك النصي هنا..."
            android:textSize="13sp"
            android:padding="10dp"
            android:background="#F1F5F9"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:layout_marginEnd="6dp"
            android:maxLines="2" />

        <Button
            android:id="@+id/btnSendText"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="إرسال"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Gemini Live Floating Bar (الترتيب والتصميم الدقيق المطابق للصورة 100%) -->
    <LinearLayout
        android:id="@+id/bottomGeminiBarLayout"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp"
        android:background="@android:color/transparent"
        android:layoutDirection="ltr">

        <!-- 1. زر إغلاق X على اليسار (أول زر من اليسار) -->
        <Button
            android:id="@+id/btnClose"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="✕"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/white_circle_btn"
            android:backgroundTint="@null"
            android:padding="0dp"
            android:layout_marginEnd="10dp" />

        <!-- 2. زر الميكروفون المباشر -->
        <Button
            android:id="@+id/btnMicToggle"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="🎙️"
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="@drawable/white_circle_btn"
            android:backgroundTint="@null"
            android:padding="0dp"
            android:layout_marginEnd="10dp" />

        <!-- 3. الكبسولة المتوهجة الملونة الساحرة لـ Gemini Live بالمنتصف -->
        <Button
            android:id="@+id/btnGeminiPill"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text=""
            android:background="@drawable/gemini_gradient_pill"
            android:backgroundTint="@null"
            android:layout_marginEnd="10dp" />

        <!-- 4. زر السهم / الإرسال المباشر -->
        <Button
            android:id="@+id/btnSendTextAction"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="⬆️"
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="@drawable/white_circle_btn"
            android:backgroundTint="@null"
            android:padding="0dp"
            android:layout_marginEnd="10dp" />

        <!-- 5. زر الكيبورد / الكاميرا على اليمين (أخر زر من اليمين) -->
        <Button
            android:id="@+id/btnKeyboardToggle"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="📷"
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="@drawable/white_circle_btn"
            android:backgroundTint="@null"
            android:padding="0dp" />

    </LinearLayout>

</RelativeLayout>
