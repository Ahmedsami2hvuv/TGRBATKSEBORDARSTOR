<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true">

    <!-- مساحة الشفافية المطلقة لإغلاق الواجهة عند النقر في الأعلى -->
    <View
        android:id="@+id/transparentClickDismiss"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomGeminiBarLayout"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <!-- بوكس الاستجابة الشفاف جداً يظهر فقط عند وجود رد صريح -->
    <LinearLayout
        android:id="@+id/responseContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomGeminiBarLayout"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/responseScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="160dp"
            android:background="#F8FAFC"
            android:padding="12dp"
            android:elevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎙️ المساعد الاستجابة"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0284C7"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvTranscript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:lineSpacingExtra="3dp" />

                <LinearLayout
                    android:id="@+id/buttonsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:visibility="gone"
        android:layout_above="@id/bottomGeminiBarLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnToggleTts"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:visibility="gone"
        android:text="🔊" />

    <LinearLayout
        android:id="@+id/textInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomGeminiBarLayout"
        android:orientation="horizontal"
        android:visibility="gone"
        android:padding="8dp"
        android:background="#FFFFFF">

        <EditText
            android:id="@+id/etCommandInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="اكتب أمرك النصي هنا..."
            android:textSize="13sp"
            android:padding="10dp"
            android:background="#F1F5F9"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:layout_marginEnd="6dp"
            android:maxLines="2" />

        <Button
            android:id="@+id/btnSendText"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="إرسال"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Gemini Live Floating Bar (الشكل والترتيب المطابق 100% للصورة المرفقة) -->
    <LinearLayout
        android:id="@+id/bottomGeminiBarLayout"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp"
        android:background="@android:color/transparent"
        android:layoutDirection="ltr">

        <!-- 1. زر إغلاق X أقصى اليسار (دائرة بيضاء بإطار أسود دائري صريح) -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#000000"
            android:background="@drawable/white_circle_black_stroke"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:layout_marginEnd="10dp" />

        <!-- 2. زر الميكروفون (دائرة بيضاء بإطار أسود دائري صريح) -->
        <ImageButton
            android:id="@+id/btnMicToggle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#000000"
            android:background="@drawable/white_circle_black_stroke"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:layout_marginEnd="10dp" />

        <!-- 3. الكبسولة المتوهجة الملونة لـ Gemini Live بالمنتصف (بدون أي كتابة داخلها 100%) -->
        <View
            android:id="@+id/btnGeminiPill"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/gemini_gradient_pill_glow"
            android:layout_marginEnd="10dp" />

        <!-- 4. زر سهم الإرسال (دائرة بيضاء بإطار أسود دائري صريح) -->
        <ImageButton
            android:id="@+id/btnSendTextAction"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@android:drawable/ic_menu_upload"
            android:tint="#000000"
            android:background="@drawable/white_circle_black_stroke"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:layout_marginEnd="10dp" />

        <!-- 5. زر الكاميرا/الكيبورد أقصى اليمين (دائرة بيضاء بإطار أسود دائري صريح) -->
        <ImageButton
            android:id="@+id/btnKeyboardToggle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="#000000"
            android:background="@drawable/white_circle_black_stroke"
            android:scaleType="centerInside"
            android:padding="12dp" />

    </LinearLayout>

</RelativeLayout>
