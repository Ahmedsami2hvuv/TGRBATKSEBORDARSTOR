<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl">

    <!-- مساحة شفافة فارغة من الأعلى تمكن المدير من رؤية الشاشة وقراءة تفاصيل الطلب بسهولة -->
    <View
        android:id="@+id/transparentClickDismiss"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomGeminiContainer"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Container المساعد الصوتي الشفاف المباشر فقط في أسفل الشاشة -->
    <LinearLayout
        android:id="@+id/bottomGeminiContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#E60F172A"
        android:padding="12dp"
        android:elevation="16dp">

        <!-- حالة الاستماع والمؤشر الصغير الشفاف -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="4dp">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="#38BDF8"
                android:visibility="gone"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ الميكروفون شغال... تحدث بحرية"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#38BDF8" />

            <Button
                android:id="@+id/btnToggleTts"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="12dp"
                android:text="🔊 الصوت"
                android:textSize="10sp"
                android:backgroundTint="#0284C7"
                android:textColor="#FFFFFF"
                android:paddingLeft="6dp"
                android:paddingRight="6dp" />
        </LinearLayout>

        <!-- نص الأمر المنطوق صوتاً -->
        <TextView
            android:id="@+id/tvTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#E2E8F0"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp" />

        <!-- بلوك شفاف أنيق وصغير لعرض رد واستجابة المساعد -->
        <ScrollView
            android:id="@+id/responseScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="160dp"
            android:background="#B31E293B"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#F8FAFC"
                    android:lineSpacingExtra="3dp" />

                <!-- حاوية الأزرار التفاعلية بالنقر المباشر -->
                <LinearLayout
                    android:id="@+id/buttonsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Text Keyboard Input Area (عند اختيار الكتابة بالنص) -->
        <LinearLayout
            android:id="@+id/textInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etCommandInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="اكتب أمرك النصي هنا..."
                android:textSize="13sp"
                android:padding="10dp"
                android:background="#334155"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:layout_marginEnd="6dp"
                android:maxLines="2" />

            <Button
                android:id="@+id/btnSendText"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="إرسال"
                android:backgroundTint="#0284C7"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Gemini Live Floating Bar أزرار عائمة سفيلية فقط (مطابقة للصور) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- 1. زر إغلاق X عائم أبيض -->
            <Button
                android:id="@+id/btnClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="✕"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:backgroundTint="#FFFFFF"
                android:padding="0dp"
                android:layout_marginEnd="8dp" />

            <!-- 2. زر إيقاف/تفعيل الميكروفون عائم أبيض -->
            <Button
                android:id="@+id/btnMicToggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="🎙️"
                android:textSize="16sp"
                android:textColor="#0F172A"
                android:backgroundTint="#FFFFFF"
                android:padding="0dp"
                android:layout_marginEnd="8dp" />

            <!-- 3. الشريط البيضاوي المتوهج المضيء لـ Gemini Live في المنتصف -->
            <Button
                android:id="@+id/btnGeminiPill"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="✨ Gemini"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0284C7"
                android:layout_marginEnd="8dp" />

            <!-- 4. زر فتح الكتابة النصية عائم أبيض -->
            <Button
                android:id="@+id/btnKeyboardToggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="⌨️"
                android:textSize="16sp"
                android:textColor="#0F172A"
                android:backgroundTint="#FFFFFF"
                android:padding="0dp" />

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
