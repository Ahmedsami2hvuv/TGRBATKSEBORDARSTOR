<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true">

    <!-- مساحة الشفافية المطلقة لإغلاق الواجهة عند النقر في الأعلى -->
    <View
        android:id="@+id/transparentClickDismiss"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomControlsLayout"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <!-- حاوية سجل دردشة المحادثة المتسلسلة فوق أسرّة التحكم والكتابة تماماً -->
    <LinearLayout
        android:id="@+id/responseContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomControlsLayout"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="40dp"
        android:paddingBottom="6dp"
        android:background="@android:color/transparent">

        <!-- شريط الحالة العلوي الصغير النظيف -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="🎙️ المساعد الصوتي جاهز..."
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="#220F172A"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <!-- السكرول فيو الشفاف الذي يحمل رسائل الدردشة المرتفعة للأعلى -->
        <ScrollView
            android:id="@+id/chatScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:background="@android:color/transparent">

            <LinearLayout
                android:id="@+id/chatMessagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="bottom"
                android:paddingBottom="12dp"
                android:background="@android:color/transparent" />
        </ScrollView>
    </LinearLayout>

    <Button
        android:id="@+id/btnToggleTts"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:visibility="gone"
        android:text="🔊" />

    <!-- قسم التحكم السفلي الموحد (يضم خلية الكتابة وكبسولة Gemini) لضمان صعود الشات كاملاً عند فتح الكتابة -->
    <LinearLayout
        android:id="@+id/bottomControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@android:color/transparent">

        <!-- وحدة الكتابة وإدخال الأوامر بنص خفيف وناعم وشفاف مرتفعة فوق الأزرار -->
        <LinearLayout
            android:id="@+id/textInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:padding="8dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="6dp"
            android:background="#330F172A">

            <EditText
                android:id="@+id/etCommandInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="اكتب أمرك النصي هنا..."
                android:textSize="13sp"
                android:padding="10dp"
                android:background="#22FFFFFF"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8"
                android:layout_marginEnd="6dp"
                android:maxLines="2" />

            <Button
                android:id="@+id/btnSendText"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="إرسال"
                android:backgroundTint="#0284C7"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Gemini Live Floating Bar المضيء والعائم في الأسفل -->
        <LinearLayout
            android:id="@+id/bottomGeminiBarLayout"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp"
            android:background="@android:color/transparent"
            android:layoutDirection="ltr">

            <!-- 1. زر إغلاق X -->
            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#000000"
                android:background="@drawable/white_circle_black_stroke"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:layout_marginEnd="10dp" />

            <!-- 2. زر الميكروفون -->
            <ImageButton
                android:id="@+id/btnMicToggle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="#000000"
                android:background="@drawable/white_circle_black_stroke"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:layout_marginEnd="10dp" />

            <!-- 3. كبسولة Gemini Live المضيئة -->
            <com.aboakbar.admin.GeminiLivePillView
                android:id="@+id/btnGeminiPill"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp" />

            <!-- 4. زر الكيبورد والكتابة النصية -->
            <ImageButton
                android:id="@+id/btnKeyboardToggle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="#000000"
                android:background="@drawable/white_circle_black_stroke"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:layout_marginEnd="10dp" />

            <!-- 5. زر تفعيل وكتم صوت المساعد الذكي (Speaker Toggle) -->
            <ImageButton
                android:id="@+id/btnVoiceToggle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:tint="#000000"
                android:background="@drawable/white_circle_black_stroke"
                android:scaleType="centerInside"
                android:padding="12dp" />

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
