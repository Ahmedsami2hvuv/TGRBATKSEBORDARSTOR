{
  "name": "aboakbar-admin",
  "version": "1.0.0",
  "description": "لوحة تحكم أبو الأكبر",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . aboakbar-admin --platform=win32 --arch=x64 --icon=build/icon.ico --out=dist --overwrite"
  },
  "author": "Abo Akbar",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.aboakbar.admin.desktop",
    "productName": "Abo Akbar Admin",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "لوحة تحكم أبو الأكبر"
    }
  }
}
