<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إضافة طلب ذو وجهتين"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#1AFFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- النص المحدد المعروض للمراجعة -->
                <TextView
                    android:id="@+id/tvSelectedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#26000000"
                    android:padding="8dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp"
                    android:maxLines="4"
                    android:scrollbars="vertical"
                    android:gravity="right" />

                <!-- رقم البائع -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="رقم هاتف البائع"
                    android:textColor="@color/sky_200"
                    android:textSize="12sp"
                    android:gravity="right" />
                <EditText
                    android:id="@+id/etSellerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:hint="أدخل رقم البائع (مثال: 077...)"
                    android:textColorHint="#80FFFFFF"
                    android:textColor="@color/white"
                    android:inputType="phone"
                    android:gravity="right|center_vertical"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp" />

                <!-- منطقة البائع -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="منطقة البائع"
                    android:textColor="@color/sky_200"
                    android:textSize="12sp"
                    android:gravity="right" />
                <AutoCompleteTextView
                    android:id="@+id/actvSellerRegion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:hint="ابحث عن منطقة البائع..."
                    android:textColorHint="#80FFFFFF"
                    android:textColor="@color/white"
                    android:gravity="right|center_vertical"
                    android:padding="10dp"
                    android:completionThreshold="1"
                    android:layout_marginBottom="12dp" />

                <!-- رقم المشتري -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="رقم هاتف المشتري"
                    android:textColor="@color/sky_200"
                    android:textSize="12sp"
                    android:gravity="right" />
                <EditText
                    android:id="@+id/etBuyerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:hint="أدخل رقم المشتري (مثال: 078...)"
                    android:textColorHint="#80FFFFFF"
                    android:textColor="@color/white"
                    android:inputType="phone"
                    android:gravity="right|center_vertical"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp" />

                <!-- منطقة المشتري -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="منطقة المشتري"
                    android:textColor="@color/sky_200"
                    android:textSize="12sp"
                    android:gravity="right" />
                <AutoCompleteTextView
                    android:id="@+id/actvBuyerRegion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:hint="ابحث عن منطقة المشتري..."
                    android:textColorHint="#80FFFFFF"
                    android:textColor="@color/white"
                    android:gravity="right|center_vertical"
                    android:padding="10dp"
                    android:completionThreshold="1"
                    android:layout_marginBottom="12dp" />

                <!-- نوع الطلب -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="نوع الطلب"
                    android:textColor="@color/sky_200"
                    android:textSize="12sp"
                    android:gravity="right" />
                <Spinner
                    android:id="@+id/spinnerOrderType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:layout_marginBottom="12dp" />

                <!-- المبالغ والأسعار -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="4dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="التوصيل"
                            android:textColor="@color/sky_200"
                            android:textSize="10sp"
                            android:gravity="center" />
                        <EditText
                            android:id="@+id/etDeliveryPrice"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/input_bg"
                            android:hint="0"
                            android:textColorHint="#80FFFFFF"
                            android:textColor="@color/white"
                            android:inputType="numberDecimal"
                            android:gravity="center" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginHorizontal="2dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="الربح"
                            android:textColor="@color/sky_200"
                            android:textSize="10sp"
                            android:gravity="center" />
                        <EditText
                            android:id="@+id/etProfit"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/input_bg"
                            android:hint="0"
                            android:textColorHint="#80FFFFFF"
                            android:textColor="@color/white"
                            android:inputType="numberDecimal"
                            android:gravity="center" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="4dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="للبائع"
                            android:textColor="@color/sky_200"
                            android:textSize="10sp"
                            android:gravity="center" />
                        <EditText
                            android:id="@+id/etSellerAmount"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/input_bg"
                            android:hint="0"
                            android:textColorHint="#80FFFFFF"
                            android:textColor="@color/white"
                            android:inputType="numberDecimal"
                            android:gravity="center" />
                    </LinearLayout>

                </LinearLayout>

                <!-- وقت الطلب -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="وقت الطلب"
                    android:textColor="@color/sky_200"
                    android:textSize="12sp"
                    android:gravity="right" />
                <EditText
                    android:id="@+id/etOrderTime"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_bg"
                    android:hint="أدخل وقت التوصيل (مثال: عاجل اليوم)"
                    android:textColorHint="#80FFFFFF"
                    android:textColor="@color/white"
                    android:inputType="text"
                    android:gravity="right|center_vertical"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp" />

                <!-- ملاحظات الطلب -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ملاحظة الموظف"
                    android:textColor="@color/sky_200"
                    android:textSize="12sp"
                    android:gravity="right" />
                <EditText
                    android:id="@+id/etOrderNote"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/input_bg"
                    android:hint="أي ملاحظات إضافية بخصوص الطلب..."
                    android:textColorHint="#80FFFFFF"
                    android:textColor="@color/white"
                    android:inputType="textMultiLine"
                    android:gravity="right|top"
                    android:padding="10dp"
                    android:layout_marginBottom="16dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:indeterminateIndeterminate="true"
                    android:indeterminateTint="@color/sky_200"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <!-- أزرار الإجراءات -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnCancel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="إلغاء"
                        android:textColor="@color/white"
                        android:backgroundTint="#FF4444"
                        android:layout_marginEnd="12dp" />

                    <Button
                        android:id="@+id/btnSubmit"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="إرسال الطلب"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/sky_200" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
