<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="16dp"
    android:background="@drawable/bg_dialog_rounded"
    android:elevation="20dp"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- الهيدر الرئيسي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/button_round_bg"
                android:gravity="center"
                android:text="⏰"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إعدادات مؤقتات التنبيه التلقائي"
                    android:textColor="#0f172a"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تحكم بحرية في تشغيل/إيقاف وتوقيت كل مهمة"
                    android:textColor="#64748b"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#e2e8f0" />

        <!-- ================= القسم الأول: مؤقت طلبات التقييم ⭐ ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#f8fafc"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⭐ تذكير طلبات التقييم"
                    android:textColor="#065f46"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEnableEvaluation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="الفاصل الزمني للتقييم (بالدقائق):"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMinusMinutes"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:backgroundTint="#e2e8f0"
                    android:text="−5"
                    android:textColor="#1e293b"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etIntervalMinutes"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:gravity="center"
                    android:hint="60"
                    android:inputType="number"
                    android:text="60"
                    android:textColor="#0f172a"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPlusMinutes"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:backgroundTint="#e2e8f0"
                    android:text="+5"
                    android:textColor="#1e293b"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chip15Min"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#ffffff"
                    android:padding="0dp"
                    android:text="15 د"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chip30Min"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#ffffff"
                    android:padding="0dp"
                    android:text="30 د"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chip60Min"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#ffffff"
                    android:padding="0dp"
                    android:text="60 د"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chip120Min"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:backgroundTint="#ffffff"
                    android:padding="0dp"
                    android:text="120 د"
                    android:textColor="#334155"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#e2e8f0" />

        <!-- ================= القسم الثاني: مؤقت مراسلة الزبائن وتخزين الأرقام 💬 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#f0f9ff"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💬 تذكير مراسلة وتخزين الزبائن"
                    android:textColor="#0369a1"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEnableOutreach"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="الفاصل الزمني للمراسلة (بالدقائق):"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMinusOutreachMinutes"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:backgroundTint="#e2e8f0"
                    android:text="−5"
                    android:textColor="#1e293b"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etOutreachIntervalMinutes"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:gravity="center"
                    android:hint="60"
                    android:inputType="number"
                    android:text="60"
                    android:textColor="#0f172a"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPlusOutreachMinutes"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:backgroundTint="#e2e8f0"
                    android:text="+5"
                    android:textColor="#1e293b"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chipOutreach15Min"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#ffffff"
                    android:padding="0dp"
                    android:text="15 د"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipOutreach30Min"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#ffffff"
                    android:padding="0dp"
                    android:text="30 د"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipOutreach60Min"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#ffffff"
                    android:padding="0dp"
                    android:text="60 د"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chipOutreach120Min"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:backgroundTint="#ffffff"
                    android:padding="0dp"
                    android:text="120 د"
                    android:textColor="#334155"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- زر الحفظ المشترك -->
        <Button
            android:id="@+id/btnSaveInterval"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4f46e5"
            android:text="✓ حفظ وتطبيق الإعدادات"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
