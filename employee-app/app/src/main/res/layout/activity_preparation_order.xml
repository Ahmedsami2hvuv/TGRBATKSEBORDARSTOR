<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- الهيدر -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/button_round_bg"
                android:gravity="center"
                android:text="🛒"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إضافة طلب تجهيز وتسوق"
                    android:textColor="#0f172a"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إسناد التجهيز لمجهز أو مورد محدد"
                    android:textColor="#64748b"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- كرت النموذج -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_rounded"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="6dp">

            <!-- اختيار المجهز أو المورد -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المجهز أو المورد المسؤول عن التجهيز *"
                android:textColor="#1e293b"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerTarget"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_bg"
                android:padding="8dp" />

            <!-- قائمة المواد والطلب -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="قائمة المواد / نص الطلب *"
                android:textColor="#1e293b"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOrderText"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_bg"
                android:gravity="top|start"
                android:hint="اكتب المواد والكميات هنا أو الصق النص..."
                android:padding="12dp"
                android:textColor="#0f172a"
                android:textColorHint="#94a3b8"
                android:textSize="14sp" />

            <!-- هاتف الزبون -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="رقم هاتف الزبون"
                android:textColor="#1e293b"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCustomerPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_bg"
                android:hint="07XXXXXXXXX"
                android:inputType="phone"
                android:padding="12dp"
                android:textColor="#0f172a"
                android:textColorHint="#94a3b8"
                android:textSize="14sp" />

            <!-- اختيار المنطقة -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="منطقة التوصيل"
                android:textColor="#1e293b"
                android:textSize="13sp"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/actvRegion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_bg"
                android:completionThreshold="1"
                android:hint="ابحث عن المنطقة أو اخترها..."
                android:padding="12dp"
                android:textColor="#0f172a"
                android:textColorHint="#94a3b8"
                android:textSize="14sp" />

            <!-- وقت الطلب -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="وقت الطلب"
                android:textColor="#1e293b"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOrderTime"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_bg"
                android:hint="عاجل اليوم"
                android:padding="12dp"
                android:text="عاجل اليوم"
                android:textColor="#0f172a"
                android:textColorHint="#94a3b8"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progressBarPrep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <!-- أزرار الإجراءات -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelPrep"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#e2e8f0"
                    android:text="إلغاء"
                    android:textColor="#475569"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSubmitPrep"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1.6"
                    android:backgroundTint="#4f46e5"
                    android:text="🚀 إرسال طلب التجهيز"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
