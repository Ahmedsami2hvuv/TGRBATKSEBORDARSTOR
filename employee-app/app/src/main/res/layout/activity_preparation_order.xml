<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- الهيدر -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/button_round_bg"
                android:gravity="center"
                android:text="🛒"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إضافة طلب تجهيز وتسوق"
                    android:textColor="#ffffff"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الصق النص ثم اضغط تحليل وحدد المجهزين"
                    android:textColor="@color/sky_200"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- كرت النموذج -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#1AFFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- 1. صندوق نص الطلب أو الرسالة -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="نص الرسالة / الطلب *"
                    android:textColor="@color/sky_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="right" />

                <EditText
                    android:id="@+id/etOrderText"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/input_bg"
                    android:gravity="top|right"
                    android:hint="الصق رسالة الزبون أو اكتب المواد هنا..."
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="14sp" />

                <!-- زر تحليل النص الذكي لاستخراج الهاتف والمنطقة -->
                <Button
                    android:id="@+id/btnAnalyzeText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#38bdf8"
                    android:text="🔍 تحليل واستخراج البيانات تلقائياً"
                    android:textColor="#0f172a"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 2. هاتف الزبون والمنطقة جنباً إلى جنب -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="رقم هاتف الزبون"
                            android:textColor="@color/sky_200"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="right" />

                        <EditText
                            android:id="@+id/etCustomerPhone"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/input_bg"
                            android:hint="07XXXXXXXXX"
                            android:inputType="phone"
                            android:padding="12dp"
                            android:textColor="@color/white"
                            android:textColorHint="#80FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="منطقة التوصيل"
                            android:textColor="@color/sky_200"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="right" />

                        <AutoCompleteTextView
                            android:id="@+id/actvRegion"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/input_bg"
                            android:completionThreshold="1"
                            android:hint="ابحث عن المنطقة..."
                            android:padding="12dp"
                            android:textColor="@color/white"
                            android:textColorHint="#80FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- وقت الطلب -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="وقت الطلب"
                    android:textColor="@color/sky_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="right" />

                <EditText
                    android:id="@+id/etOrderTime"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/input_bg"
                    android:hint="عاجل اليوم"
                    android:padding="12dp"
                    android:text="عاجل اليوم"
                    android:textColor="@color/white"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="14sp" />

                <!-- 3. قسم اختيار المجهزين والموردين بصح (Checkboxes) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="المجهز أو المورد المسؤول عن التجهيز (ضع صح) *"
                    android:textColor="#fcd34d"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="right" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="يمكنك اختيار أكثر من مجهز أو مورد لإسناد الطلب إليهم:"
                    android:textColor="#cbd5e1"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <!-- حاوية مربعات الاختيار الديناميكية -->
                <LinearLayout
                    android:id="@+id/containerTargetsCheckboxes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#26000000"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <ProgressBar
                        android:id="@+id/pbLoadingTargets"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/sky_200" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBarPrep"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="14dp"
                    android:indeterminateTint="@color/sky_200"
                    android:visibility="gone" />

                <!-- أزرار الإجراءات -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCancelPrep"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:backgroundTint="#FF4444"
                        android:text="إلغاء"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnSubmitPrep"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1.6"
                        android:backgroundTint="#10b981"
                        android:text="🚀 إرسال طلب التجهيز"
                        android:textColor="#ffffff"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
