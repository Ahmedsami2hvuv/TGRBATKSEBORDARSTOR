<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="12dp"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="16dp"
    android:elevation="16dp">

    <!-- هيدر الإشعار مع زر ضبط الوقت -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/button_round_bg"
            android:gravity="center"
            android:text="⭐"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="طلب تقييم زبون (مجدول)"
                android:textColor="#0f172a"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRemainingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الطلبات المتبقية بانتظار التقييم: ..."
                android:textColor="#64748b"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- زر ضبط وتغيير وقت التنبيه -->
        <Button
            android:id="@+id/btnChangeInterval"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#e0e7ff"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="⚙️ ضبط الوقت"
            android:textColor="#4338ca"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#e2e8f0" />

    <!-- المحتوى القابل للتمرير (تفاصيل الطلب والرسالة) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="320dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- كرت تفاصيل الطلب -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvOrderNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#fef3c7"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="#..."
                        android:textColor="#b45309"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvShopName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="المحل: ..."
                        android:textColor="#0f172a"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRegionAndPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="📍 المنطقة | 📞 الهاتف"
                    android:textColor="#334155"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- نص الرسالة المقترحة -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="نص رسالة التقييم المقترحة للواتساب:"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGeneratedMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#f8fafc"
                android:padding="12dp"
                android:text="..."
                android:textColor="#0f172a"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#e2e8f0" />

    <!-- أزرار الإجراءات السفلية (كبيرة وواضحة وثابتة دائماً) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSkipEvaluation"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#f1f5f9"
            android:text="تخطي / لاحقاً"
            android:textColor="#475569"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSendEvaluation"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1.8"
            android:backgroundTint="#16a34a"
            android:text="💬 إرسال بالواتساب"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
