<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="12dp"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp"
    android:elevation="24dp">

    <!-- الهيدر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/button_round_bg"
            android:gravity="center"
            android:text="💬"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مهمة مراسلة وتخزين أرقام الزبائن"
                android:textColor="#0f172a"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOutreachRemainingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الزبائن المتبقين في القائمة: 0"
                android:textColor="#0284c7"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="#e2e8f0" />

    <!-- بطاقة معلومات الزبون -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="بيانات الزبون المطلوب مراسلته:"
            android:textColor="#64748b"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOutreachPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="077XXXXXXXX"
            android:textColor="#0f172a"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOutreachOriginalInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#475569"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- نص الرسالة المقترح إرسالها -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="نص الرسالة التي سيتم إرسالها:"
        android:textColor="#1e293b"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxHeight="160dp">

        <TextView
            android:id="@+id/tvOutreachMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#f8fafc"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:text="نص الرسالة..."
            android:textColor="#334155"
            android:textSize="13sp" />
    </ScrollView>

    <!-- زر الإرسال المباشر -->
    <Button
        android:id="@+id/btnSendOutreach"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#059669"
        android:elevation="4dp"
        android:text="💬 فتح الواتساب لإرسال الرسالة وتأشير الرقم"
        android:textColor="#ffffff"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- أزرار التحكم السفلية -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSkipOutreach"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#f1f5f9"
            android:text="تخطي / لاحقاً"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnChangeOutreachInterval"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#eff6ff"
            android:text="⚙️ ضبط الوقت / إيقاف"
            android:textColor="#2563eb"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
